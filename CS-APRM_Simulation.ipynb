import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import milp, LinearConstraint, Bounds

# =============================================================
# 1. ENVIRONMENT SETUP & SIMULATION
# =============================================================
np.random.seed(42)

NUM_GENRES = 8       # Dimension of genre space |G|
NUM_ITEMS = 60       # Newly released titles |I_new|
K_SLATE = 10         # Recommendation display slots K

# Generate user profile: normalized historical genre engagement
user_genre_profile = np.random.dirichlet(np.ones(NUM_GENRES) * 1.5)
user_genre_profile /= np.linalg.norm(user_genre_profile)

# Generate cold-start items: multi-genre attribute vectors
item_genres = np.random.exponential(scale=1.0, size=(NUM_ITEMS, NUM_GENRES))
item_genres /= np.linalg.norm(item_genres, axis=1, keepdims=True)

# Promotional intensity scores p_i in [0, 1]
promotional_scores = np.random.beta(a=2.0, b=3.5, size=NUM_ITEMS)

# Rank discount weights: w_k = 1 / log2(k + 1) for k = 1 ... K
ranks = np.arange(1, K_SLATE + 1)
rank_weights = 1.0 / np.log2(ranks + 1)

# Compute Cosine Similarities: CosSim(u, v_i)
cosine_sims = np.dot(item_genres, user_genre_profile)


# =============================================================
# 2. EXACT ILP SOLVER (CS-APRM)
# =============================================================
def solve_cs_aprm(cos_sim, promo_scores, beta, p_max, weights, k_slate):
    n_items = len(cos_sim)
    n_vars = n_items * k_slate

    c = np.zeros(n_vars)
    for i in range(n_items):
        for k in range(k_slate):
            idx = i * k_slate + k
            net_utility = cos_sim[i] - beta * promo_scores[i]
            c[idx] = - (weights[k] * net_utility)

    integrality = np.ones(n_vars)
    bounds = Bounds(lb=0.0, ub=1.0)

    # Constraint 1: Exactly 1 item per rank slot k
    A_eq1 = np.zeros((k_slate, n_vars))
    for k in range(k_slate):
        for i in range(n_items):
            A_eq1[k, i * k_slate + k] = 1.0
    b_eq1 = np.ones(k_slate)

    # Constraint 2: An item appears at most once on the slate
    A_ub2 = np.zeros((n_items, n_vars))
    for i in range(n_items):
        for k in range(k_slate):
            A_ub2[i, i * k_slate + k] = 1.0
    b_ub2 = np.ones(n_items)

    # Constraint 3: Cumulative promotional cap
    A_ub3 = np.zeros((1, n_vars))
    for i in range(n_items):
        for k in range(k_slate):
            A_ub3[0, i * k_slate + k] = promo_scores[i]
    b_ub3 = np.array([p_max])

    constraints = [
        LinearConstraint(A_eq1, b_eq1, b_eq1),
        LinearConstraint(A_ub2, 0.0, b_ub2),
        LinearConstraint(A_ub3, 0.0, b_ub3)
    ]

    res = milp(c=c, integrality=integrality, bounds=bounds, constraints=constraints)
    if not res.success:
        return None

    X_matrix = res.x.reshape((n_items, k_slate))
    chosen_item_indices = np.argmax(X_matrix, axis=0)

    slate_cos = cos_sim[chosen_item_indices]
    slate_promo = promo_scores[chosen_item_indices]

    return {
        "indices": chosen_item_indices,
        "slate_cos": slate_cos,
        "slate_promo": slate_promo,
        "mos": np.mean(slate_cos),
        "ppf": np.sum(slate_promo),
        "dcog": np.sum(slate_cos * weights)
    }


# =============================================================
# 3. EXPERIMENTAL DATA GENERATION
# =============================================================
# Sweep Beta (Promotional penalty sensitivity)
beta_vals = np.linspace(0.0, 1.2, 30)
sweep_beta_promo, sweep_beta_dcog = [], []
for b in beta_vals:
    sol = solve_cs_aprm(cosine_sims, promotional_scores, beta=b, p_max=5.0, 
                         weights=rank_weights, k_slate=K_SLATE)
    sweep_beta_promo.append(sol["ppf"] if sol else np.nan)
    sweep_beta_dcog.append(sol["dcog"] if sol else np.nan)

# Sweep P_max (Pareto frontier)
pmax_vals = np.linspace(1.5, 6.5, 30)
sweep_pmax_promo, sweep_pmax_mos = [], []
for pm in pmax_vals:
    sol = solve_cs_aprm(cosine_sims, promotional_scores, beta=0.4, p_max=pm, 
                         weights=rank_weights, k_slate=K_SLATE)
    sweep_pmax_promo.append(sol["ppf"] if sol else np.nan)
    sweep_pmax_mos.append(sol["mos"] if sol else np.nan)

# Baseline vs Regulated model point comparison
baseline = solve_cs_aprm(cosine_sims, promotional_scores, beta=0.0, p_max=10.0, 
                         weights=rank_weights, k_slate=K_SLATE)
regulated = solve_cs_aprm(cosine_sims, promotional_scores, beta=0.6, p_max=3.0, 
                          weights=rank_weights, k_slate=K_SLATE)


# =============================================================
# 4. INDIVIDUAL PLOTS (RENDERED AND SAVED SEPARATELY)
# =============================================================

# Global styling configuration
plt.rcParams.update({
    'font.size': 11,
    'axes.labelsize': 12,
    'axes.titlesize': 13,
    'xtick.labelsize': 10,
    'ytick.labelsize': 10
})

# -------------------------------------------------------------
# PLOT 1: Sensitivity to Penalty Parameter Beta
# -------------------------------------------------------------
fig1, ax1_1 = plt.subplots(figsize=(8, 5.5), dpi=300)
ax1_2 = ax1_1.twinx()

line1 = ax1_1.plot(beta_vals, sweep_beta_promo, color='#c0392b', linewidth=2.4, 
                   marker='o', markersize=5, label='Promotional Footprint (PPF)')
line2 = ax1_2.plot(beta_vals, sweep_beta_dcog, color='#2980b9', linewidth=2.4, 
                   marker='s', markersize=5, linestyle='--', label='Organic Quality (DCOG@10)')

ax1_1.set_title('Sensitivity to Promotional Penalty Factor (β)', fontweight='bold', pad=12)
ax1_1.set_xlabel('Promotional Penalty Coefficient (β)')
ax1_1.set_ylabel('Platform Promotional Footprint (PPF)', color='#c0392b')
ax1_2.set_ylabel('Discounted Cumulative Organic Gain (DCOG@10)', color='#2980b9')
ax1_1.tick_params(axis='y', labelcolor='#c0392b')
ax1_2.tick_params(axis='y', labelcolor='#2980b9')
ax1_1.grid(True, linestyle=':', alpha=0.6)

lines = line1 + line2
labels = [l.get_label() for l in lines]
ax1_1.legend(lines, labels, loc='center right', frameon=True, facecolor='white', framealpha=0.9)

fig1.tight_layout()
fig1.savefig('plot_1_beta_sensitivity.png', dpi=300)
plt.show()

# -------------------------------------------------------------
# PLOT 2: Pareto Trade-Off Curve (P_max Sweep)
# -------------------------------------------------------------
fig2, ax2 = plt.subplots(figsize=(8, 5.5), dpi=300)

scatter = ax2.scatter(sweep_pmax_promo, sweep_pmax_mos, c=pmax_vals, cmap='viridis', 
                      s=75, edgecolors='black', linewidth=0.8, zorder=3)
ax2.plot(sweep_pmax_promo, sweep_pmax_mos, color='#7f8c8d', linestyle=':', linewidth=1.5, zorder=2)
cbar = fig2.colorbar(scatter, ax=ax2)
cbar.set_label('Promotional Cap Budget ($P_{max}$)', fontsize=11)

ax2.set_title('Pareto Trade-Off: Organic Match vs. Commercial Saturation', fontweight='bold', pad=12)
ax2.set_xlabel('Total Slate Promotional Exposure (PPF)')
ax2.set_ylabel('Mean Organic Cosine Similarity (MOS)')
ax2.grid(True, linestyle=':', alpha=0.6)

ax2.axvspan(2.5, 3.5, color='#2ecc71', alpha=0.18, label='Recommended Operating Range')
ax2.legend(loc='lower right', frameon=True)

fig2.tight_layout()
fig2.savefig('plot_2_pareto_frontier.png', dpi=300)
plt.show()

# -------------------------------------------------------------
# PLOT 3: Positional Promotional Intensity Across Display Ranks
# -------------------------------------------------------------
fig3, ax3 = plt.subplots(figsize=(8, 5.5), dpi=300)
bar_width = 0.38
x_pos = np.arange(1, K_SLATE + 1)

ax3.bar(x_pos - bar_width/2, baseline['slate_promo'], width=bar_width, 
        label='Unregulated Baseline (β=0, Cap Off)', color='#e74c3c', alpha=0.85, 
        edgecolor='black', linewidth=0.5)
ax3.bar(x_pos + bar_width/2, regulated['slate_promo'], width=bar_width, 
        label='CS-APRM Model (β=0.6, $P_{max}$=3.0)', color='#27ae60', alpha=0.85, 
        edgecolor='black', linewidth=0.5)

ax3.set_title('Positional Promotional Intensity Across Display Ranks', fontweight='bold', pad=12)
ax3.set_xlabel('Display Rank Position on Slate ($k$)')
ax3.set_ylabel('Item Promotional Score ($p_i$)')
ax3.set_xticks(x_pos)
ax3.set_ylim(0, 1.05)
ax3.legend(loc='upper right', frameon=True)
ax3.grid(True, axis='y', linestyle=':', alpha=0.6)

fig3.tight_layout()
fig3.savefig('plot_3_positional_promotional_intensity.png', dpi=300)
plt.show()

# -------------------------------------------------------------
# PLOT 4: Positional Organic Quality Retention Profile
# -------------------------------------------------------------
fig4, ax4 = plt.subplots(figsize=(8, 5.5), dpi=300)

ax4.plot(x_pos, baseline['slate_cos'], marker='o', linewidth=2.2, color='#e74c3c', 
         label='Unregulated Baseline')
ax4.plot(x_pos, regulated['slate_cos'], marker='s', linewidth=2.2, color='#2980b9', 
         linestyle='--', label='CS-APRM Model')

ax4.set_title('Organic Alignment Profile Across Display Ranks', fontweight='bold', pad=12)
ax4.set_xlabel('Display Rank Position on Slate ($k$)')
ax4.set_ylabel('Cosine Similarity with User Profile')
ax4.set_xticks(x_pos)
ax4.set_ylim(0.4, 1.0)
ax4.legend(loc='lower left', frameon=True)
ax4.grid(True, linestyle=':', alpha=0.6)

fig4.tight_layout()
fig4.savefig('plot_4_positional_organic_similarity.png', dpi=300)
plt.show()
